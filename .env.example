# =============================================================================
# Black in Blockchain — variables d'environnement (valeurs FACTICES)
# Copier en .env.local pour le développement. Ne jamais committer de vraie clé.
# Tout ce qui envoie un e-mail, coûte de l'argent ou écrit dans un service
# distant est DÉSACTIVÉ par défaut (drapeaux FEATURE_* à "false").
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase BIB (projet DÉDIÉ : bib-staging / bib-production) ---------------
# Jamais un projet Supabase d'un autre produit.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet-bib.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clé secrète : serveur uniquement (Vercel « Sensitive »), jamais NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Brevo (newsletter) -------------------------------------------------------
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_API_URL=https://api.brevo.com/v3
BREVO_LIST_ID_FR=0
BREVO_LIST_ID_EN=0
BREVO_DOI_TEMPLATE_ID_FR=0
BREVO_DOI_TEMPLATE_ID_EN=0
BREVO_SENDER_NAME=Black in Blockchain
BREVO_SENDER_EMAIL=newsletter@example.org

# Version du texte de consentement affiché dans le formulaire.
NEWSLETTER_CONSENT_VERSION=2026-11-v1
# Poivre pour les empreintes (e-mail, IP) : OBLIGATOIRE pour activer
# l'inscription (32 caractères minimum, secret, distinct par environnement).
# Sans valeur conforme, /api/newsletter répond 503 (fail closed).
# Exemple de génération : openssl rand -hex 32
NEWSLETTER_EMAIL_HASH_PEPPER=
# Nombre maximal de régénérations IA par édition (mardi).
NEWSLETTER_MAX_REGENERATIONS=2

# --- Moteur IA ------------------------------------------------------------------
# Activation : FEATURE_AI=true + AI_PROVIDER + AI_API_KEY (voir docs/DEPLOYMENT.md § 7).
# AI_PROVIDER :
#   anthropic          URL par défaut ; AI_MODEL facultatif (défaut claude-sonnet-5-5)
#   openai             URL par défaut ; AI_MODEL obligatoire
#   mistral            URL par défaut ; AI_MODEL obligatoire
#   openai-compatible  AI_BASE_URL (https) et AI_MODEL obligatoires
#   mock               réponses simulées sans clé ni coût — INTERDIT en production
# Vérification : GET /api/ops/ai-status (Bearer CRON_SECRET) ; test de clé : POST.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_CALLS_PER_RUN=4
# Plafond de jetons (entrée + sortie) par exécution ; dépassement = arrêt.
AI_MAX_TOKENS_PER_RUN=60000
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=60000

# --- Traitements planifiés et alertes ----------------------------------------
# Secret partagé avec GitHub Actions (BIB_CRON_SECRET), 32 caractères minimum.
CRON_SECRET=
# Adresse(s) d'alerte interne, séparées par des virgules.
OPS_ALERT_EMAIL_TO=

# --- Drapeaux (tous désactivés par défaut) ------------------------------------
FEATURE_NEWSLETTER_SUBSCRIBE=false
FEATURE_NEWSLETTER_AUTOSEND=false
FEATURE_NEWS_INGEST=false
FEATURE_AI=false
FEATURE_OPS_ALERTS=false
FEATURE_SOB_READ_FROM_SUPABASE=false

# Accueil : contenus factuels non sourcés (registre src/lib/content/claims.ts)
# MASQUÉS par défaut. "true" les réaffiche (décision éditoriale explicite).
# Inventaire : docs/EDITORIAL_CLAIMS.md.
HOME_SHOW_UNVERIFIED_SECTIONS=false

# --- Pipeline State of BIB (GitHub Actions / poste opérateur) ----------------
# SUPABASE_URL=https://votre-projet-bib.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# SOB_SUPABASE_SYNC=false
